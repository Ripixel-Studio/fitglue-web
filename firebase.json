{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/features",
        "destination": "/how-it-works",
        "type": 301
      },
      {
        "regex": "^/@james/(?P<key>week-\\d{2}-\\d{4}|month-\\d{2}-\\d{4}|year-\\d{4})/?$",
        "destination": "https://james.ripixel.co.uk/life/roundup/:key",
        "type": 301
      },
      {
        "regex": "^/@james/(?P<slug>[^/]+)/?$",
        "destination": "https://james.ripixel.co.uk/life/activity/:slug/",
        "type": 301
      },
      {
        "regex": "^/@james(/.*)?$",
        "destination": "https://james.ripixel.co.uk/life",
        "type": 301
      },
      {
        "regex": "^/showcase/.+$",
        "destination": "https://james.ripixel.co.uk/life",
        "type": 301
      },
      {
        "source": "/showcase",
        "destination": "https://james.ripixel.co.uk/life",
        "type": 301
      },
      {
        "regex": "^/@.*$",
        "destination": "/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/hooks/**",
        "run": {
          "serviceId": "api-webhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/webhooks/**",
        "run": {
          "serviceId": "api-webhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/mobile/**",
        "run": {
          "serviceId": "api-webhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/v2/**",
        "run": {
          "serviceId": "api-client",
          "region": "us-central1"
        }
      },
      {
        "source": "/auth/**",
        "run": {
          "serviceId": "api-client",
          "region": "us-central1"
        }
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ]
  }
}